# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code
# Project config is versioned — agents, hooks and the gate list are part of
# how this repo is reviewed. Only local overrides stay private.
.claude/settings.local.json
.claude/*.local.json

# local binaries
cloudflared.exe

# user uploads (local disk — migrate to object storage before prod)
/public/uploads/

# video assets (use object storage or CDN instead)
*.mp4
